<?xml version="1.0"?>
<sdf version="1.9">
  <world name="indoor_warehouse">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Ground plane -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls -->
    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="walls_link">
        <!-- North wall -->
        <collision name="north_wall">
          <pose>0 20 3 0 0 0</pose>
          <geometry>
            <box>
              <size>40 0.3 6</size>
            </box>
          </geometry>
        </collision>
        <!-- South wall -->
        <collision name="south_wall">
          <pose>0 -20 3 0 0 0</pose>
          <geometry>
            <box>
              <size>40 0.3 6</size>
            </box>
          </geometry>
        </collision>
        <!-- East wall -->
        <collision name="east_wall">
          <pose>20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 40 6</size>
            </box>
          </geometry>
        </collision>
        <!-- West wall -->
        <collision name="west_wall">
          <pose>-20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 40 6</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Shelving units -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-5 5 0 0 0 0</pose>
      <link name="shelf_link">
        <collision name="shelf_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="shelf_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_2">
      <static>true</static>
      <pose>-5 0 0 0 0 0</pose>
      <link name="shelf_link">
        <collision name="shelf_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="shelf_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_3">
      <static>true</static>
      <pose>-5 -5 0 0 0 0</pose>
      <link name="shelf_link">
        <collision name="shelf_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="shelf_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crates -->
    <model name="crate_1">
      <static>true</static>
      <pose>3 3 0 0 0 0</pose>
      <link name="crate_link">
        <collision name="crate_col">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="crate_vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lighting -->
    <light type="point" name="light_1">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <intensity>0.8</intensity>
      <attenuation_range>20</attenuation_range>
    </light>

    <!-- Sun -->
    <light type="directional" name="sun">
      <pose>10 10 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- Plugin for ROS2 communication -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  </world>
</sdf>