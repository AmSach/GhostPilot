<?xml version="1.0"?>
<sdf version="1.6">
  <world name="indoor_warehouse">
    <!-- Indoor warehouse world for GhostPilot GPS-denied testing -->
    
    <!-- Ground plane -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <grid>1</grid>
    </scene>
    
    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>
    
    <!-- Warehouse structure -->
    <actor name="building">
      <pose>0 0 0 0 0 0</pose>
      <link name="floor">
        <visual name="floor_vis">
          <geometry>
            <box>
              <size>20 15 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- Walls -->
      <link name="wall_north">
        <pose>0 7.5 1.5 0 0 0</pose>
        <visual name="wall_north_vis">
          <geometry>
            <box>
              <size>20 0.2 3</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      
      <link name="wall_south">
        <pose>0 -7.5 1.5 0 0 0</pose>
        <visual name="wall_south_vis">
          <geometry>
            <box>
              <size>20 0.2 3</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </actor>
    
    <!-- Obstacles (shelving units) -->
    <model name="shelf_1">
      <pose>3 3 0 0 0 0</pose>
      <static>1</static>
      <link name="body">
        <visual name="vis">
          <geometry>
            <box>
              <size>1 5 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    
    <model name="shelf_2">
      <pose>3 -3 0 0 0 0</pose>
      <static>1</static>
      <link name="body">
        <visual name="vis">
          <geometry>
            <box>
              <size>1 5 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    
    <!-- Include drone model -->
    <include>
      <uri>model://iris_with_slamba</uri>
      <name>drone</name>
      <pose>0 0 0.1 0 0 0</pose>
    </include>
  </world>
</sdf>